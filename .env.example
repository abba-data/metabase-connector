# Metabase
METABASE_URL=https://analytics.atlasauthority.com
METABASE_API_KEY=

# Connector
CONNECTOR_HOST=0.0.0.0
CONNECTOR_PORT=8000
LOG_LEVEL=INFO

# Per-RPC default freshness window (days). Eventual-consistency caveat surfaced via response envelope.
DEFAULT_FRESHNESS_WINDOW_DAYS=60

# Per-Metabase-call timeout (seconds). 202 responses surface as EXCEEDED_SYNC_WINDOW.
METABASE_TIMEOUT_SECONDS=30

# Metabase version pin enforced by client; mismatch fails health check.
METABASE_VERSION_PIN=

# API keys for connector consumers (comma-separated key=name:scope1,scope2). Dev-only; rotate via secret manager in prod.
# Format: <api_key>=<consumer_id>|<consumer_type>|<scope>,<scope>
# Example: dev-test-key-1=cron-job-1|backend_service_account|general
CONNECTOR_API_KEYS=
