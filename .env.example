# All settings are loaded by Pydantic with env_prefix="APP_". Per CLAUDE.md
# never read os.environ directly anywhere in the codebase — go through
# AppSettings (load_settings()).

# Environment selector. local | staging | production.
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_DEBUG=false

# HTTP server
APP_HOST=0.0.0.0
APP_PORT=8000

# Metabase
APP_METABASE_URL=https://analytics.atlasauthority.com
APP_METABASE_API_KEY=
APP_METABASE_TIMEOUT_SECONDS=30
APP_METABASE_VERSION_PIN=

# Connector consumer keys. Format per entry:
#   <key>=<consumer_id>|<consumer_type>|<scope1,scope2>[|<rate_limit_class>]
# Multiple entries separated by `;` or newlines.
# Consumer types: backend_service_account | interactive_script | llm_agent
# Scopes: general | raw_sql | operator
APP_CONNECTOR_API_KEYS=

# Default eventual-consistency window surfaced in response envelope (days).
APP_DEFAULT_FRESHNESS_WINDOW_DAYS=60

# Audit log (SEC-02). audit_store: sqlite (default) or memory.
APP_AUDIT_STORE=sqlite
APP_AUDIT_DB_PATH=./data/audit.sqlite
APP_AUDIT_RETENTION_DAYS=365

# Rate limiting (slowapi format: <n>/<period>; empty disables).
APP_RATE_LIMIT_DEFAULT=60/minute
APP_RATE_LIMIT_RAW_SQL=30/minute
APP_RATE_LIMIT_OPERATOR=120/minute

# Card IDs — find in Metabase URL `…/question/<id>-some-slug`.
APP_CARD_ID_PARTNER_REVENUE=
APP_CARD_ID_CHANNEL_SPLIT=
APP_CARD_ID_TOP_PARTNERS=
APP_CARD_ID_MRR_TREND=159
APP_CARD_ID_ARR_AT_RISK=
APP_CARD_ID_UPSELL_OPPORTUNITIES=
APP_CARD_ID_REVENUE_COMPARISON=
APP_CARD_ID_DATA_QUALITY_SIGNALS=
APP_CARD_ID_LICENSE_QUERY=

# Datadog (no-op when APP_ENV=local)
APP_DD_SERVICE=metabase-connector
APP_DD_ENV=local
